# ==============================================================================
# 1. SHARED CONFIGURATION & SECRETS (Both Local & Production)
# ==============================================================================

# Resend Mail Service (Used in /api/contact and CV notification)
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=your_email@gmail.com

# Vercel Blob Storage Configuration
AAM_STORE_ID=store_xxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
NEXT_PUBLIC_BLOB_BASE_URL=https://xxxxxxxxxxxx.public.blob.vercel-storage.com


# ==============================================================================
# 2. LOCAL DEVELOPMENT ENVIRONMENT (Active on Local Machine)
# ==============================================================================

# Local Frontend URL
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Backend API (Uncomment when running backend locally on port 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:4000


# ==============================================================================
# 3. PRODUCTION DEPLOYMENT ENVIRONMENT (Set on Vercel Dashboard / Live Server)
# ==============================================================================

# Live Site Base URL
NEXT_PUBLIC_SITE_URL=https://abdullahalmaksud.com

# Live CV Download URL
CV_DOWNLOAD_URL=https://abdullahalmaksud.com/CV%20of%20Abdullah%20Al%20Maksud.pdf

# Production Backend API Target (Proxied through Next.js rewrites to eliminate CORS)
# BACKEND_API_URL=https://api-abdullahalmaksud.vercel.app
